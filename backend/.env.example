# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/ghoul_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ghoul_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_super_secret_key_here_at_least_32_characters_long
JWT_EXPIRY=7d

# ============================================
# Email Configuration (Nodemailer with Gmail)
# ============================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password_16_chars
EMAIL_FROM=noreply@ghoul.com

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
